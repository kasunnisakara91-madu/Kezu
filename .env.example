# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server Port (default: 3000)
PORT=3000

# MongoDB Connection String (leave empty for built-in persistent storage fallback)
MONGODB_URL="mongodb+srv://<username>:<password>@cluster0.mongodb.net/criminal_api?retryWrites=true&w=majority"

# JWT Secret for signing authentication tokens
JWT_SECRET="criminal_api_super_secret_jwt_key_dct_team_2026"

# Default Admin Credentials for initial setup
ADMIN_EMAIL="admin@criminal-api.dct"
ADMIN_PASSWORD="Admin@Criminal2026!"

# API Base URL (used in code snippets & docs)
API_BASE_URL="http://localhost:3000"
